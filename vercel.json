{
  "buildCommand": "npm run build && npm run build:site",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "*/**": false
    }
  },
  "redirects": [
    {
      "source": "/print.html",
      "destination": "/italie/print.html",
      "permanent": false
    },
    {
      "source": "/printboek.pdf",
      "destination": "/italie/printboek.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/italie/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
